@model BA.Dmo.Web.Pages.JobOn.JobOnToolCardModel
@{
    var component = Model.Component;
    var statusClass = component is null ? "neutral" : "info";
    var statusLabel = component is null ? "Por preencher" : "Registado";
    var fields = BA.Dmo.Web.Pages.JobOn.IndexModel.ToolFields(component, Model.Code);
    var registeredFamily = Model.Code is "CM" or "MF" or "BQ";
}
<article class="tool-card @(Model.Priority ? "priority-tool" : "") @Model.ExtraClass" data-family="@Model.Code">
    <header>
        <div><span class="tool-code">@Model.Code</span><small>@Model.Name</small></div>
        <span class="status @statusClass">@statusLabel</span>
    </header>
    <div class="tool-fields @(Model.Priority ? "" : "two")">
        @* Empty tool values render blank — never a placeholder dash (shell rule, see 11_SHELL_00_README.md). *@
        <label><span>Referência</span><input value="@(component?.ReferenceSnapshot ?? "")" aria-label="Referência @Model.Code" readonly="@(registeredFamily ? "readonly" : null)"></label>
        <label><span>Lote</span><input value="@(component?.LotSnapshot ?? "")" aria-label="Lote @Model.Code" readonly="@(registeredFamily ? "readonly" : null)"></label>
        @foreach (var field in fields)
        {
            <label><span>@field.Label</span><input value="@field.Value" data-field-key="@field.Key" data-value-type="@field.ValueType" data-existing="@field.Existing.ToString().ToLowerInvariant()" data-display-order="@field.DisplayOrder"></label>
        }
        <label><span>Stock</span><input type="number" step="0.01" value="@(component?.StockSnapshot?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) ?? "")" data-component-property="stockSnapshot"></label>
        <label><span>@(Model.Code == "BQ" ? "Necessárias" : "Em máquina")</span><input type="number" step="0.01" value="@(component?.PlannedQuantity?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) ?? "")" data-component-property="plannedQuantity"></label>
        <label><span>Utilização</span><input value="@(component?.UsageSnapshot?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) ?? "")" data-component-property="usageSnapshot" readonly></label>
        <label class="notes-field span-all"><span>Notas @Model.Code</span><textarea>@(component?.Notes ?? "")</textarea><button class="expand-note" type="button">Expandir</button></label>
    </div>
    @if (Model.Priority && Model.CanEdit)
    {
        <button class="button compact edit-only tool-change" type="button" data-family="@Model.Code">Alterar @Model.Code</button>
    }
</article>
