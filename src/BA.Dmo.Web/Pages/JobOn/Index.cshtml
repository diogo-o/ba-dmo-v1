@page "/jobon"
@model BA.Dmo.Web.Pages.JobOn.IndexModel
@using BA.Dmo.Domain.Modules.JobOn
@using BA.Dmo.Web.Pages.JobOn
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = BA.Dmo.Web.Authorization.CapabilityPolicies.JobonView)]
@{
    // GLOBAL SHELL FREEZE: the global header/primary nav/user block stay standard.
    // Job On owns only its secondary navigation, production rail and workspace below.
    ViewData["Title"] = "Job On";
    ViewData["FullBleed"] = true;
    ViewData["can-edit"] = Model.CanEdit.ToString().ToLowerInvariant();
    ViewData["can-confirm-verifications"] = Model.CanConfirm.ToString().ToLowerInvariant();
    var initialView = Model.JobOnId.HasValue ? "sheet" : "planning";
    var cm = Model.Component(ComponentFamily.MP_CM);
    var bq = Model.Component(ComponentFamily.BQ);
    var mf = Model.Component(ComponentFamily.MF);
    var pu = Model.Component(ComponentFamily.PU);
    var an = Model.Component(ComponentFamily.AN);
    var arr = Model.Component(ComponentFamily.ARR);
    var cal = Model.Component(ComponentFamily.CAL);
    var pi = Model.Component(ComponentFamily.PI);
    var cs = Model.Component(ComponentFamily.CS);
    var tp = Model.Component(ComponentFamily.TP);
    var fo = Model.Component(ComponentFamily.FO);
}

@if (Model.JobOnId is not null)
{
    <meta name="jobon-id" content="@Model.JobOnId">
    <meta name="jobon-revision-id" content="@Model.CurrentRevisionId">
}

<link rel="stylesheet" href="~/styles/modules/jobon-canonical-design-system.css" asp-append-version="true" />
<link rel="stylesheet" href="~/styles/modules/jobon-layout.css" asp-append-version="true" />

<div class="jobon-canonical-root" data-initial-view="@initialView">
    <nav class="module-tabs dmo-secondary-nav" aria-label="Navegação Job On">
        <button class="@(initialView == "planning" ? "active" : "")" data-tab="planning" data-view="planeamento" type="button">Planeamento</button>
        <button class="@(initialView == "sheet" ? "active" : "")" data-tab="sheet" data-view="folha" type="button">Job On</button>
        @if (Model.CanViewControlo) { <button data-tab="control" type="button">Controlo</button> }
        <button data-tab="history" data-view="historico" type="button">Histórico</button>
        @if (Model.CanConfigure) { <button data-tab="settings" data-view="definicoes" type="button">Definições</button> }
    </nav>

    <div class="app-layout jobon-app-layout">
        <aside class="production-rail" id="productionRail">
            <div class="rail-head"><div><span>Linhas</span><strong>Produção atual</strong></div><button class="rail-toggle" id="railToggle" type="button" aria-expanded="false">Ver linhas</button></div>
            <div class="line-list" id="linePanel" data-testid="line-panel">
                @foreach (var line in new[] { "B1", "B2", "B3", "C1", "C2", "C3" })
                {
                    <button class="line-card" type="button" data-line="@line"><span class="line-code">@line</span><span class="line-state idle">A carregar</span><small>Contexto de produção</small></button>
                }
            </div>
        </aside>

        <main class="workspace">
            <section class="view planning-view @(initialView == "planning" ? "active" : "")" id="planningView" data-selected-date="@Model.SelectedDateValue">
                <div class="page-heading"><div><span class="eyebrow">Planeamento</span><h1>Produções planeadas</h1><p>Selecione um dia para consultar ou preparar os Job Ons.</p></div>@if (Model.CanEdit){<button class="button primary" id="newJob" type="button">Criar Job On</button>}</div>
                <div class="planning-grid">
                    <section class="surface calendar-card">
                        <div id="calendar" data-dmo-calendar data-month="@Model.SelectedDateValue.Substring(0, 7)" data-record-dates="@Model.RecordDatesCsv" data-record-lines='@Model.RecordLinesJson'>
                            <div class="calendar-head dmo-calendar__head"><button class="icon-button dmo-icon-button" type="button" data-calendar-prev aria-label="Mês anterior">‹</button><strong data-calendar-label></strong><button class="icon-button dmo-icon-button" type="button" data-calendar-next aria-label="Mês seguinte">›</button></div>
                            <div class="weekday dmo-calendar__week"><span>Seg</span><span>Ter</span><span>Qua</span><span>Qui</span><span>Sex</span><span>Sáb</span><span>Dom</span></div>
                            <div class="calendar dmo-calendar__grid" data-calendar-grid></div>
                        </div>
                        <div class="calendar-legend"><span><i class="line-dot b1"></i>B1</span><span><i class="line-dot b2"></i>B2</span><span><i class="line-dot b3"></i>B3</span><span><i class="line-dot c1"></i>C1</span><span><i class="line-dot c2"></i>C2</span><span><i class="line-dot c3"></i>C3</span></div>
                    </section>
                    <section class="surface jobs-card">
                        <div class="section-heading"><div><h2>Job Ons de @Model.SelectedDateDisplay</h2><p>Um clique seleciona; duplo clique abre a folha.</p></div><div class="compact-filter"><label>Linhas</label><select id="planning-lines"><option>20</option><option>40</option><option>60</option></select></div></div>
                        <section class="loaded-job-context empty" id="loadedJobContext" aria-live="polite">
                            <div class="loaded-job-empty"><strong>Nenhum Job On carregado</strong><span>Selecione uma produção da lista para carregar o contexto.</span></div>
                            <div class="loaded-job-content" hidden><div class="loaded-job-heading"><div><span>Job On carregado</span><strong id="loadedJobTitle">—</strong></div><span class="status success">Contexto ativo</span></div><div class="loaded-job-data"><div><span>Referência</span><strong id="loadedJobReference">—</strong></div><div><span>Produção</span><strong id="loadedJobProduction">—</strong></div><div><span>Máquina</span><strong id="loadedJobMachine">—</strong></div><div><span>Revisão</span><strong id="loadedJobRevision">—</strong></div></div><div class="loaded-job-actions">@if(Model.CanViewControlo){<button class="button ghost" id="openLoadedControl" type="button">Ver Controlo</button>}@if(Model.CanViewRepairs){<button class="button ghost" id="openLoadedRepairs" type="button">Ver reparações</button>}<button class="button primary" id="openLoadedSheet" type="button">Abrir Folha Job On</button></div></div>
                        </section>
                        <div class="jobs-list" id="jobList" data-list data-dmo-list>
                            @if (Model.PlaneamentoItems.Count == 0) { <div class="loaded-job-context empty"><div class="loaded-job-empty"><strong>Nenhum Job On planeado</strong><span>Não existem produções para o dia selecionado.</span></div></div> }
                            @foreach (var item in Model.PlaneamentoItems)
                            {
                                <article class="job-row" tabindex="0" data-job-row data-dmo-row data-id="@item.JobOnId" data-job-id="@item.JobOnId" data-production="@item.Production" data-reference="@item.Reference" data-line="@item.Machine" data-line-key="@item.LineColorKey" data-revision="@item.RevisionNumber" data-date="@item.DateIso" data-full-date="@item.Date" data-open-url="@Url.Page("/JobOn/Index", new { id = item.JobOnId })">
                                    <div class="date-block"><strong>@item.DayLabel</strong><span>@item.TimeRange</span></div><div><span class="job-line @(item.LineColorKey is null ? "" : "line-" + item.LineColorKey)">@item.Machine</span><strong>@item.Reference</strong><small>Produção @item.Production</small></div><div><span>Preparação</span><strong>@item.PreparationDisplay</strong><small>Rev. @item.RevisionNumber</small></div><span class="status @item.LifecyclePillClass">@item.LifecycleDisplay</span>
                                </article>
                            }
                        </div>
                        <div class="list-footer"><span>@Model.PlaneamentoItems.Count Job Ons · Página 1 de 1</span><div><button class="icon-button" type="button" disabled>‹</button><span>1 / 1</span><button class="icon-button" type="button" disabled>›</button></div></div>
                    </section>
                </div>
            </section>

            <section class="view sheet-view @(initialView == "sheet" ? "active" : "")" id="sheetView"><span id="jobSheet" hidden></span>
                <div class="sheet-title-row">
                    <div class="sheet-heading"><button class="text-action" id="backPlanning" type="button">← Voltar ao planeamento</button><h1>Folha Job On</h1></div>
                    <div class="production-navigator" aria-label="Contexto e Job Ons anteriores desta referência"><div class="navigator-context"><div class="navigator-production"><span>Produção</span><div class="production-switcher"><button class="icon-button" id="previousProduction" type="button" aria-label="Produção anterior">‹</button><label><select id="productionSelect" aria-label="Produção"><option value="@Model.ProductionDisplay" data-job-id="@Model.JobOnId" data-line="@Model.MachineDisplay" data-revision="@Model.CurrentRevisionNumber">@Model.ProductionNavDisplay</option></select></label><button class="icon-button" id="nextProduction" type="button" aria-label="Produção seguinte" disabled>›</button></div></div></div><button class="text-action" id="openReferenceHistory" type="button">Ver histórico completo</button></div>
                    <div class="mode-indicator" id="modeIndicator"><span class="mode-dot"></span><strong>Modo consulta</strong></div>
                </div>

                <section class="surface summary-surface">
                    <div class="summary-grid">
                        <label class="summary-cell key"><span>Data inicial</span><input id="jobStartDate" type="date" value="@Model.StartDateDisplay"></label><label class="summary-cell key"><span>Data final</span><input id="jobEndDate" type="date" value="@Model.EndDateDisplay"></label><label class="summary-cell key short"><span>Máquina</span><select id="sheetMachine"><option>@Model.MachineDisplay</option></select></label><label class="summary-cell identity"><span>Referência</span><input value="@Model.ReferenceDisplay"></label><label class="summary-cell identity"><span>Produção</span><input id="sheetProduction" value="@Model.ProductionDisplay"></label><label class="summary-cell tiny"><span>Secções</span><input value="@Model.SectionsDisplay"></label><label class="summary-cell tiny"><span>Gota</span><input value="@Model.DropCountDisplay"></label><label class="summary-cell tiny"><span>Tipo</span><input value="@Model.TypeDisplay"></label><label class="summary-cell short"><span>Paragem</span><input value="@Model.StopDisplay"></label><label class="summary-cell short"><span>Peso</span><input value="@Model.WeightDisplay"></label><label class="summary-cell short"><span>Processo</span><select><option>@Model.ProcessDisplay</option></select></label>
                    </div>
                    <div class="action-bar"><div class="primary-actions">@if(Model.CanEdit){<button class="button primary" id="editSheet" type="button">Editar folha</button><button class="button primary edit-only" id="saveSheet" type="button">Guardar nova revisão</button><button class="button ghost edit-only" id="cancelEdit" type="button">Cancelar edição</button>}</div><div class="secondary-actions">@if (Model.JobOnId.HasValue && Model.CanViewControlo){<a class="button ghost" id="viewSheetControl" asp-page="/Controlo/Index" asp-route-jobOn="@Model.JobOnId" asp-route-revision="@Model.CurrentRevisionId">Ver Controlo</a>}@if (Model.JobOnId.HasValue && Model.CanViewRepairs){<a class="button ghost" id="viewSheetRepairs" asp-page="/ReparacaoInterna/Index" asp-route-view="historico" asp-route-jobOnId="@Model.JobOnId" asp-route-revision="@Model.CurrentRevisionId" asp-route-production="@Model.ProductionDisplay" asp-route-line="@Model.MachineDisplay">Ver reparações</a>}@if(Model.CanEdit){<button class="button ghost edit-only" type="button">Alterar data</button>}@if(Model.JobOnId.HasValue && Model.CanEdit){<button class="button ghost" id="duplicateJobOn" type="button">Duplicar</button>}<button class="button ghost" type="button">Comparar</button><button class="button ghost" id="printJobOn" type="button">Imprimir 4 folhas</button><div class="more-actions-menu"><button class="button more" type="button" data-more-actions aria-label="Mais ações" aria-expanded="false">•••</button><div class="tool-menu">@if(Model.JobOnId.HasValue && Model.CanViewControlo){<a asp-page="/Controlo/Index" asp-route-jobOn="@Model.JobOnId" asp-route-revision="@Model.CurrentRevisionId" asp-route-section="peso">Ver Peso</a><a asp-page="/Controlo/Index" asp-route-jobOn="@Model.JobOnId" asp-route-revision="@Model.CurrentRevisionId" asp-route-section="pegamentos">Ver Pegamentos</a><a asp-page="/Controlo/Index" asp-route-jobOn="@Model.JobOnId" asp-route-revision="@Model.CurrentRevisionId" asp-route-section="resumo">Ver Resumo</a>}</div></div></div></div>
                </section>

                @if (Model.HasPendingVerifications) { <div class="preparation-alert"><div class="alert-icon">!</div><div><strong>Preparação pendente</strong><span>@string.Join(" · ", Model.VerificationItems.Where(item => item.IsPending).Take(3).Select(item => item.RuleText))</span></div><button class="text-action" id="goChecks" type="button">Ver verificações</button></div> }

                <section class="priority-grid">
                    <partial name="_ToolCard" model="@(new JobOnToolCardModel(cm, "CM", "Contra molde", true, Model.CanEdit))" />
                    <div class="tool-stack bq-stack"><partial name="_ToolCard" model="@(new JobOnToolCardModel(bq, "BQ", "Boquilha", true, Model.CanEdit))" /><partial name="_ToolCard" model="@(new JobOnToolCardModel(an, "AN", "Anel da boquilha", false, Model.CanEdit, "related-card"))" /></div>
                    <partial name="_ToolCard" model="@(new JobOnToolCardModel(mf, "MF", "Molde final", true, Model.CanEdit))" />
                    <div class="tool-stack pu-stack"><partial name="_ToolCard" model="@(new JobOnToolCardModel(pu, "PU", "Porta-unidades", true, Model.CanEdit))" /><partial name="_ToolCard" model="@(new JobOnToolCardModel(arr, "ARR", "Arrefecedores", false, Model.CanEdit, "related-card"))" /></div>
                    <article class="article-card priority-image"><header><div><strong>Imagem do artigo</strong><span>@Model.ReferenceDisplay · Produção @Model.ProductionDisplay</span></div><span class="status info">Referência</span></header><button class="article-image" id="articleImage" type="button" aria-label="Ampliar imagem do artigo">@if(Model.JobOnId.HasValue){<img id="article-reference-image" src="/api/jobon/@Model.JobOnId.Value/image" alt="Imagem completa do artigo @Model.ReferenceDisplay" hidden>}<span id="article-image-empty">Sem imagem associada</span></button><footer><span>A imagem é apresentada integralmente, sem corte.</span>@if(Model.CanEdit){<label class="button compact edit-only" for="job-image-input">Carregar imagem</label><input id="job-image-input" type="file" accept="image/*" hidden><button class="button compact edit-only" id="remove-image-btn" type="button">Remover</button>}</footer></article>
                </section>

                <section class="inventory-picker surface edit-only" id="inventoryPicker"><div class="section-heading"><div><h2 id="pickerTitle">Alterar CM associado</h2><p>Escolha outra ferramenta compatível. A associação só muda quando guardar a nova revisão.</p></div></div><div class="picker-filters"><label><span>Referência ou nome técnico</span><input value="@Model.ReferenceDisplay" placeholder="Pesquisar"></label><label><span>Máquina</span><select><option>@Model.MachineDisplay</option></select></label><label><span>Localização</span><select><option>Todas</option></select></label><label><span>Estado</span><select><option>Todos</option></select></label><button class="button ghost" type="button">Limpar</button></div><div class="table-scroll"><table><thead><tr><th>Referência</th><th>Lote</th><th>Nome técnico</th><th>Localização</th><th>Estado</th><th>Utilização</th></tr></thead><tbody><tr><td colspan="6">Catálogo de ferramentas ainda não ligado nesta superfície.</td></tr></tbody></table></div></section>

                <section class="secondary-grid">
                    <article class="tool-card cal-card"><header><span class="tool-code">CAL</span><span class="status @(cal is null ? "neutral" : "info")">@(cal is null ? "Por preencher" : "Registado")</span></header><div class="table-scroll"><table class="cal-table"><thead><tr><th>Elemento</th><th>Valor</th><th>Qtd.</th></tr></thead><tbody>@if(cal?.Rows is { Count: > 0 }){@foreach(var row in cal.Rows.OrderBy(row => row.DisplayOrder)){<tr><td>@row.ElementLabel</td><td>@(row.ValueText ?? row.ValueDecimal?.ToString("0.##") ?? "") @row.Unit</td><td>@(row.MachineQuantity?.ToString("0.##") ?? "")</td></tr>}}else{<tr><td colspan="3">Sem calibres registados.</td></tr>}</tbody></table></div></article>
                    <partial name="_ToolCard" model="@(new JobOnToolCardModel(pi, "PI", "Pinças", false, Model.CanEdit))" /><partial name="_ToolCard" model="@(new JobOnToolCardModel(cs, "CS", "Cabeça de sopro", false, Model.CanEdit))" /><partial name="_ToolCard" model="@(new JobOnToolCardModel(tp, "TP", "Tampão", false, Model.CanEdit))" /><partial name="_ToolCard" model="@(new JobOnToolCardModel(fo, "FO", "Ferramenta opcional", false, Model.CanEdit))" />
                </section>

                <section class="lower-grid" id="checksSection"><article class="surface checks-card"><div class="section-heading"><div><h2>Verificações</h2><p>Confirmações manuais desta produção.</p></div><span class="status @(Model.PendingVerificationCount > 0 ? "warning" : "success")">@Model.PendingVerificationCount pendentes</span></div><div class="check-list">@if(Model.VerificationItems.Count == 0){<div class="check-row"><span>Nenhuma verificação registada.</span></div>}@foreach(var verification in Model.VerificationItems){<label class="check-row @(verification.IsChecked ? "confirmed" : "")"><input type="checkbox" checked="@(verification.IsChecked ? "checked" : null)" disabled="@(!Model.CanConfirm ? "disabled" : null)"><span><strong>@verification.RuleText</strong><small>@(verification.CompletedBy ?? "Por confirmar") @(verification.CompletedAt is null ? "" : "· " + verification.CompletedAt)</small></span><span class="status @verification.StatusPillClass">@verification.StatusDisplay</span></label>}</div></article><article class="surface general-notes"><div class="section-heading"><div><h2>Notas gerais</h2><p>Informação transversal desta produção.</p></div></div><textarea>@Model.GeneralNotesDisplay</textarea></article></section>
                <section class="surface history-card"><div class="section-heading"><div><h2>Histórico desta produção</h2><p>Alterações, verificações e movimentos relacionados.</p></div><span class="status neutral">Revisão @Model.CurrentRevisionNumber</span></div><div class="table-scroll"><table><thead><tr><th>Data/hora</th><th>Evento</th><th>Ferramenta</th><th>Detalhe</th><th>Utilizador</th></tr></thead><tbody><tr><td colspan="5">Leitura do audit trail ainda não exposta pelo backend.</td></tr></tbody></table></div></section><span hidden>Folha de ferramentas</span>
            </section>

            @if (Model.CanViewControlo)
            {
                <section class="view control-view" id="controlView"><div class="page-heading"><div><span class="eyebrow">Controlo</span><h1>Controlo da produção escolhida</h1><p>O Job On aberto define automaticamente o contexto operacional.</p></div></div><section class="current-job-card" id="currentJobCard"><div><span>Job On atual aberto por este utilizador</span><strong>@Model.ProductionDisplay · @Model.ReferenceDisplay · @Model.MachineDisplay</strong><small>job_on_id: <code>@(Model.JobOnId?.ToString() ?? "—")</code> · revisão exata <b>@Model.CurrentRevisionNumber</b></small></div>@if(Model.JobOnId.HasValue){<a class="button ghost" asp-page="/Controlo/Index" asp-route-jobOn="@Model.JobOnId" asp-route-revision="@Model.CurrentRevisionId">Abrir Controlo real</a>}</section><section class="surface control-context"><div><span>Referência</span><strong>@Model.ReferenceDisplay</strong></div><div><span>Produção</span><strong>@Model.ProductionDisplay</strong></div><div><span>Máquina</span><strong>@Model.MachineDisplay</strong></div><div><span>CM</span><strong>@(cm?.ReferenceSnapshot ?? "") · @(cm?.LotSnapshot ?? "")</strong></div><div><span>MF</span><strong>@(mf?.ReferenceSnapshot ?? "") · @(mf?.LotSnapshot ?? "")</strong></div><div><span>BQ</span><strong>@(bq?.ReferenceSnapshot ?? "") · @(bq?.LotSnapshot ?? "")</strong></div></section><div class="control-shell surface"><nav class="control-tabs" aria-label="Áreas de Controlo"><button class="active" type="button">Resumo</button><button type="button">Peso</button><button type="button">Comparação</button><button type="button">Pegamentos</button><button type="button">Histórico</button></nav><section class="control-panel active"><div class="section-heading"><div><h2>Resumo do controlo desta produção</h2><p>Os registos detalhados permanecem no módulo Controlo, ligados à revisão exata.</p></div></div></section></div></section>
            }

            <section class="view history-view" id="historyView"><div class="page-heading"><div><span class="eyebrow">Histórico</span><h1>Job Ons por Referência e Produção</h1><p>Selecione a Referência e depois a Produção. As revisões anteriores nunca são alteradas.</p></div></div><section class="surface history-filters"><label><span>Pesquisar Referência</span><input value="@(Model.JobOnId.HasValue ? Model.ReferenceDisplay : "")"></label><label><span>Máquina</span><select><option>Todas</option></select></label><label><span>Desde</span><input type="date"></label><label><span>Até</span><input type="date"></label><button class="button ghost" type="button">Limpar filtros</button></section><section class="history-browser"><article class="surface reference-list"><div class="section-heading"><div><h2>Referências</h2><p>Um clique seleciona.</p></div></div>@if(Model.JobOnId.HasValue){<button class="history-choice active" type="button"><strong>@Model.ReferenceDisplay</strong><span>Produção atual @Model.ProductionDisplay</span></button>}</article><article class="surface production-list"><div class="section-heading"><div><h2>Produções</h2><p>O histórico completo mantém as revisões imutáveis.</p></div></div><div class="table-scroll"><table><thead><tr><th>Produção</th><th>Datas</th><th>Linha</th><th>Processo</th><th>Revisões</th><th>Estado</th></tr></thead><tbody>@if(Model.JobOnId.HasValue){<tr class="selected"><td><strong>@Model.ProductionDisplay</strong></td><td>@Model.StartDateDisplay – @Model.EndDateDisplay</td><td>@Model.MachineDisplay</td><td>@Model.ProcessDisplay</td><td>@Model.RevisionCount</td><td><span class="status @Model.LifecyclePillClass">@Model.LifecycleDisplay</span></td></tr>}else{<tr><td colspan="6">Abra um Job On para consultar o seu contexto histórico.</td></tr>}</tbody></table></div></article></section></section>

            @if (Model.CanConfigure)
            {
                <section class="view settings-view" id="settingsView"><div class="page-heading"><div><span class="eyebrow">Definições</span><h1>Opções configuráveis do Job On</h1><p>Apenas com autorização; desativar uma opção nunca altera folhas históricas.</p><span hidden>Opções dos campos</span></div><button class="button primary" type="button">Adicionar opção</button></div><section class="surface annual-directory-settings"><div class="section-heading"><div><h2>Diretório principal dos documentos</h2><p>A configuração real do diretório permanece centralizada na aplicação.</p></div></div></section><section class="surface history-filters"><label><span>Família</span><select><option>PI</option><option>CM</option><option>MF</option><option>CAL</option></select></label><label><span>Campo</span><select><option>Opções configuráveis</option></select></label><label><span>Estado</span><select><option>Ativas</option></select></label><button class="button ghost" type="button">Limpar filtros</button></section><section class="surface settings-table"><div class="section-heading"><div><h2>Opções do campo</h2><p>O catálogo de opções ainda não está ligado a esta vista.</p></div></div><div class="table-scroll"><table><thead><tr><th>Ordem</th><th>Valor</th><th>Etiqueta</th><th>Estado</th><th>Uso</th></tr></thead><tbody><tr><td colspan="5">Sem dados disponíveis.</td></tr></tbody></table></div></section></section>
            }
        </main>
    </div>

    <dialog class="image-dialog" id="imageDialog"><button class="dialog-close" type="button" aria-label="Fechar">×</button><img id="image-dialog-preview" alt="Imagem ampliada do artigo"><strong>@Model.ReferenceDisplay</strong><span>Produção @Model.ProductionDisplay · Linha @Model.MachineDisplay</span></dialog>

    @* Real creation flow: the planning "Criar Job On" button opens this dialog and
       submits the minimum real production context server-side (POST /api/jobon).
       The machine list is the canonical production lines source (never derived
       from components). *@
    @if (Model.CanEdit)
    {
        <dialog class="document-dialog job-create-dialog" id="newJobDialog" aria-labelledby="newJobTitle">
            <h2 id="newJobTitle">Criar Job On</h2>
            <p>Registo de uma produção real: referência, linha e datas planeadas. A folha abre no fim da criação.</p>
            <form id="newJobForm" novalidate>
                <div class="create-fields">
                    <label class="full"><span>Produção</span><input name="productionCode" type="text" required placeholder="Ex.: 202608"></label>
                    <label class="full"><span>Referência</span><input name="reference" type="text" required placeholder="Ex.: 5447T173"></label>
                    <label><span>Máquina / Linha</span><select name="machineCode" required>@foreach (var line in BA.Dmo.Domain.Modules.JobOn.ProductionLines.Canonical){<option value="@line">@line</option>}</select></label>
                    <label><span>Data inicial</span><input name="plannedStartAt" type="date"></label>
                    <label class="full"><span>Data final (opcional)</span><input name="plannedEndAt" type="date"></label>
                </div>
                <p class="create-error" id="newJobError" role="alert"></p>
                <div class="dialog-actions">
                    <button class="button ghost" type="button" id="newJobCancel">Cancelar</button>
                    <button class="button primary" type="submit" id="newJobSubmit">Criar Job On</button>
                </div>
            </form>
        </dialog>
    }

    @* Real duplicate flow: the sheet "Duplicar" button opens this dialog and
       submits only the NEW production/date context (POST /api/jobon/{id}/duplicate).
       The reference and tool setup are reused from the source revision; the source
       Job On is never modified. The new folha opens after a successful duplicate. *@
    @if (Model.CanEdit && Model.JobOnId.HasValue)
    {
        <dialog class="document-dialog job-create-dialog" id="duplicateJobDialog" aria-labelledby="duplicateJobTitle">
            <h2 id="duplicateJobTitle">Duplicar Job On</h2>
            <p>Nova produção a partir de @Model.ProductionDisplay · @Model.ReferenceDisplay. A preparação é copiada e o Job On original não é alterado.</p>
            <form id="duplicateJobForm" novalidate>
                <div class="create-fields">
                    <label class="full"><span>Produção</span><input name="productionCode" type="text" required placeholder="Ex.: 202609"></label>
                    <label><span>Máquina / Linha</span><select name="machineCode" required>@foreach (var line in BA.Dmo.Domain.Modules.JobOn.ProductionLines.Canonical){<option value="@line" selected="@(line == Model.MachineDisplay ? "selected" : null)">@line</option>}</select></label>
                    <label><span>Data inicial</span><input name="plannedStartAt" type="date"></label>
                    <label class="full"><span>Data final (opcional)</span><input name="plannedEndAt" type="date"></label>
                </div>
                <p class="create-error" id="duplicateJobError" role="alert"></p>
                <div class="dialog-actions">
                    <button class="button ghost" type="button" id="duplicateJobCancel">Cancelar</button>
                    <button class="button primary" type="submit" id="duplicateJobSubmit">Duplicar Job On</button>
                </div>
            </form>
        </dialog>
    }
</div>

<script src="~/scripts/jobon-canonical-interactions.js" defer></script>
<script src="~/scripts/jobon.js" defer></script>
