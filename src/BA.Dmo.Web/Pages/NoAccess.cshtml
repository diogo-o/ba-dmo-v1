@page "/no-access"
@model BA.Dmo.Web.Pages.NoAccessModel
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@{
    Layout = null; // Safe state renders without the module shell (GLM-SHL-06).
}
<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>BA DMO — Sem acesso</title>
    <link rel="stylesheet" href="~/styles/dmo-tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/styles/dmo-foundation.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/styles/dmo-components.css" asp-append-version="true" />
</head>
<body>
    <main class="dmo-safe-state">
        <section class="dmo-safe-state__card">
            @if (Model.BackendUnavailable)
            {
                <h1>Serviço temporariamente indisponível</h1>
                <p>Não foi possível carregar o acesso à aplicação neste momento. Tente novamente em instantes.</p>
            }
            else
            {
                <h1>Sem acesso</h1>
                <p>A sua sessão está autenticada, mas não tem módulos atribuídos. Contacte a Administração.</p>
            }
            <a class="dmo-button outline" href="/logout">Terminar sessão</a>
        </section>
    </main>
</body>
</html>
