@inject BA.Dmo.Application.Shared.Shell.IShellService Shell
@{
    // GLOBAL SHELL FREEZE: this header, the primary navigation (_Navigation) and
    // the user/profile block are the global BA DMO shell. Module visual-authority
    // designs (e.g. the Job On canonical port) must NOT override them unless the
    // owner explicitly requests it. See 11_SHELL_00_README.md — GLOBAL SHELL FREEZE.
    //
    // Global header — reference dmo-app-header anatomy (DMO §6): logo +
    // page identity + user block (name + profile title, presentation only,
    // UD-02) with the account trigger. Derivation/grants untouched (U-07).
    var shell = Shell.Current;
    var pageTitle = ViewData["Title"] as string;
    // Admin scope (contract §1): set by _Layout before this partial renders;
    // in admin scope the brand block is the reference admin-header identity
    // (h1 "Portal DMO" + p "Administração") instead of the module page title.
    var adminScope = ViewData["AdminScope"] is bool admin && admin;
}
@* Global header — 3-zone grid model (GLOBAL NAVIGATION STABILITY RULE):
   LEFT zone (brand + current module title) | CENTER zone (global primary
   navigation) | RIGHT zone (user block). The center track is independent of
   the left/right track widths, so switching modules must never shift the
   primary navigation. See 11_SHELL_00_README.md — GLOBAL SHELL FREEZE. *@
<header class="app-header dmo-app-header">
    <div class="dmo-app-header__left">
        <a href="/" class="app-brand" aria-label="BA DMO — início">
            <img class="dmo-app-header__logo" src="~/assets/ba-logo.png" alt="BA" />
        </a>
        @if (!string.IsNullOrWhiteSpace(pageTitle))
        {
            if (adminScope)
            {
                <div class="dmo-app-header__page">
                    <h1>Portal DMO</h1>
                    <p>Administração</p>
                </div>
            }
            else
            {
                <div class="dmo-app-header__page">
                    <h1>@pageTitle</h1>
                </div>
            }
        }
    </div>
    @* In Admin there is already a dedicated Admin tab strip inside the page.
       Do not render the global shell "Administração" tab as a second menu. *@
    @if (!adminScope)
    {
        <partial name="_Navigation" />
    }
    @if (shell is not null)
    {
        <div class="dmo-app-header__user" data-testid="shell-user">
            <strong data-user-profile-name>@shell.DisplayName</strong>
            @if (!string.IsNullOrWhiteSpace(shell.ProfileTitle))
            {
                <span data-user-profile-title data-testid="shell-profile-title">@shell.ProfileTitle</span>
            }
            <a href="/logout" data-testid="shell-logout">Terminar sessão</a>
        </div>
    }
</header>
