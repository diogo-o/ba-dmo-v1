@page "/admin/users"
@model BA.Dmo.Web.Pages.Admin.Users.IndexModel
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = BA.Dmo.Web.Authorization.AdminPolicies.AdminGerir)]
@{
    ViewData["Title"] = "Administração";
}
<partial name="_AdminNav" />
<div class="dmo-page-head">
    <div>
        <h2>Utilizadores</h2>
        <p>Cada utilizador recebe um template reutilizável que define título/função, perfil e módulos.</p>
    </div>
    <a class="dmo-button" href="/admin/users/create">Criar utilizador</a>
</div>
@if (!string.IsNullOrEmpty(Model.Feedback))
{
    <div class="dmo-alert success" role="status">@Model.Feedback</div>
}
@if (!string.IsNullOrEmpty(Model.ServiceErrorMessage))
{
    <div class="dmo-form-message" role="alert">@Model.ServiceErrorMessage</div>
}
@if (!string.IsNullOrEmpty(Model.ServiceErrorMessage))
{
    <div class="dmo-empty-state">
        <strong>Serviço de administração indisponível</strong>
        <p>Não foi possível carregar a lista de utilizadores neste momento. Contacte um administrador.</p>
    </div>
}
else
{
    <form method="get" class="dmo-toolbar dmo-card">
        <div class="dmo-field search">
            <label for="q">Pesquisar</label>
            <input id="q" name="q" type="text" value="@Model.Search" placeholder="Nome, email, título ou perfil" />
        </div>
        <div class="dmo-field">
            <label for="stateFilter">Estado</label>
            <select id="stateFilter" name="state">
                <option value="">Todos</option>
                <option value="active" selected="@(Model.StateFilter?.ToLower() == "active")">Ativos</option>
                <option value="inactive" selected="@(Model.StateFilter?.ToLower() == "inactive")">Inativos</option>
            </select>
        </div>
        <button type="submit" class="dmo-button">Pesquisar</button>
    </form>
    <div class="dmo-selection-toolbar" data-dmo-toolbar-for="userRows">
        <a class="dmo-button" href="#"
           data-dmo-act="open"
           data-dmo-url="/admin/users/edit?id={id}"
           disabled aria-disabled="true">Editar</a>
        <form id="userResetForm" method="post" asp-page-handler="ResetPassword" class="dmo-inline-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" data-dmo-row-id-input value="" />
            <button type="submit" class="dmo-button danger"
                    data-dmo-act="form" data-dmo-form="userResetForm"
                    data-dmo-confirm="Iniciar reset de password para o utilizador selecionado?"
                    disabled aria-disabled="true">Reset password</button>
        </form>
    </div>
    <div class="dmo-card dmo-table-card">
        <div class="dmo-table-title">
            <h3>Contas internas</h3>
            <span class="dmo-pill">@Model.Users.Count utilizadores</span>
        </div>
        <div class="dmo-table-wrap">
            <table class="dmo-table">
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Email</th>
                        <th>Título / função</th>
                        <th>Perfil</th>
                        <th>Estado</th>
                        <th>Atualizado</th>
                    </tr>
                </thead>
                <tbody id="userRows" data-dmo-list role="listbox">
                    @foreach (var user in Model.Users)
                    {
                        <tr data-dmo-row
                            data-id="@user.ActorId"
                            data-open-url="/admin/users/edit?id=@Uri.EscapeDataString(user.ActorId)"
                            role="option"
                            aria-selected="false">
                            <td><strong>@user.DisplayName</strong></td>
                            <td>
                                @if (string.IsNullOrWhiteSpace(user.AuthEmail))
                                {
                                    <span class="dmo-pill inactive">Email indisponível</span>
                                }
                                else
                                {
                                    @user.AuthEmail
                                }
                            </td>
                            <td><strong>@Model.TemplateTitleFor(user)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(user.ProfileTitle) ? "—" : user.ProfileTitle)</td>
                            <td>
                                <span class="@(user.Active ? "dmo-pill active" : "dmo-pill inactive")">
                                    @(user.Active ? "Ativo" : "Inativo")
                                </span>
                            </td>
                            <td>@user.UpdatedAtUtc.ToString("dd/MM/yyyy · HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="dmo-pagination">
            Um clique seleciona; duplo clique abre a edição.
        </p>
    </div>
}
