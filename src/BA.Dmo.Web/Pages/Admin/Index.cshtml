@page "/admin"
@model BA.Dmo.Web.Pages.Admin.IndexModel
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = BA.Dmo.Web.Authorization.AdminPolicies.AdminGerir)]
@{
    ViewData["Title"] = "Administração";
}
<partial name="_AdminNav" />
<div class="dmo-page-head">
    <div>
        <h2>Administração</h2>
        <p>Gestão de utilizadores, templates de acesso, aplicações e auditoria.</p>
    </div>
</div>
<div class="dmo-card">
    <div class="dmo-modal-body">
        <div class="dmo-row-actions">
            <a class="dmo-button" href="/admin/users">Utilizadores internos</a>
            <a class="dmo-button" href="/admin/templates">Templates de acesso</a>
            <a class="dmo-button" href="/admin/applications">Aplicações (catálogo)</a>
            <a class="dmo-button" href="/admin/audit">Auditoria</a>
        </div>
    </div>
</div>
