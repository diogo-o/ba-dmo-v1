@page "/admin/templates"
@model BA.Dmo.Web.Pages.Admin.Templates.IndexModel
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = BA.Dmo.Web.Authorization.AdminPolicies.AdminGerir)]
@{
    ViewData["Title"] = "Administração";
}
<partial name="_AdminNav" />
<div class="dmo-page-head">
    <div>
        <h2>Templates de acesso</h2>
        <p>Os grants são validados contra o catálogo canónico; entradas desconhecidas são rejeitadas.</p>
    </div>
    <a class="dmo-button" href="/admin/templates/edit">Criar template</a>
</div>
@if (!string.IsNullOrEmpty(Model.Feedback))
{
    <div class="dmo-alert success">@Model.Feedback</div>
}
<div class="dmo-selection-toolbar" data-dmo-toolbar-for="templateRows">
    <a class="dmo-button" data-dmo-act="open" data-dmo-url="/admin/templates/edit?id={id}" disabled aria-disabled="true">Editar</a>
    <span class="dmo-field__helper">Um clique seleciona; duplo clique abre a edição.</span>
</div>
<div class="dmo-card dmo-table-card">
    <div class="dmo-table-title">
        <h3>Templates</h3>
        <span class="dmo-pill">@Model.Templates.Count template(s)</span>
    </div>
    <div class="dmo-table-wrap">
        <table class="dmo-table">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Identificador</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody id="templateRows" data-dmo-list>
                @if (Model.Templates.Count == 0)
                {
                    <tr>
                        <td colspan="3" class="empty">Sem templates. <a href="/admin/templates/edit">Criar template</a></td>
                    </tr>
                }
                @foreach (var template in Model.Templates)
                {
                    <tr data-dmo-row
                        data-id="@template.TemplateId"
                        data-open-url="/admin/templates/edit?id=@Uri.EscapeDataString(template.TemplateId)"
                        aria-selected="false">
                        <td><strong>@template.Name</strong></td>
                        <td>@template.TemplateId</td>
                        <td>
                            <span class="@(template.Active ? "dmo-pill active" : "dmo-pill inactive")">
                                @(template.Active ? "Ativo" : "Inativo")
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
