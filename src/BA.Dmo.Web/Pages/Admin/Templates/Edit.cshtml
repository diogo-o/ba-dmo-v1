@page "/admin/templates/edit"
@model BA.Dmo.Web.Pages.Admin.Templates.EditModel
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = BA.Dmo.Web.Authorization.AdminPolicies.AdminGerir)]
@{
    ViewData["Title"] = "Administração";
}
<partial name="_AdminNav" />
<div class="dmo-page-head">
    <div>
        <h2>@(Model.IsNew ? "Criar template" : "Editar template")</h2>
        <p>Um template define o título/função, um único perfil funcional e os módulos atribuídos.</p>
    </div>
    <a class="dmo-button" href="/admin/templates">Voltar à lista</a>
</div>
<div class="dmo-card">
    <div class="dmo-modal-body">
        @if (ViewData.ModelState.ErrorCount > 0)
        {
            <div asp-validation-summary="All" class="dmo-form-message"></div>
        }
        <form method="post">
            @Html.AntiForgeryToken()
            @if (Model.IsNew)
            {
                <div class="dmo-field">
                    <label for="templateId">Identificador interno</label>
                    <input id="templateId" name="templateId" type="text" required value="@Model.TemplateId" />
                    <p class="dmo-field__helper">Ex.: reparador, chefe-producao, controlador-metrologia.</p>
                </div>
            }
            else
            {
                <input type="hidden" name="templateId" value="@Model.TemplateId" />
                <input type="hidden" name="version" value="@Model.Version.ToString("O")" />
            }
            <div class="dmo-modal-grid">
                <div class="dmo-field">
                    <label for="name">Título / Função</label>
                    <input id="name" name="name" type="text" required value="@Model.Name" placeholder="Ex.: Reparador" />
                    <p class="dmo-field__helper">É o nome reutilizável que aparece associado aos utilizadores.</p>
                </div>
                <div class="dmo-field">
                    <label for="functionalProfile">Perfil funcional</label>
                    <select id="functionalProfile" name="functionalProfile" required>
                        <option value="Operador / Controlador" selected="@(Model.FunctionalProfile == "Operador / Controlador")">Operador / Controlador</option>
                        <option value="Responsável" selected="@(Model.FunctionalProfile == "Responsável")">Responsável</option>
                        <option value="Admin" selected="@(Model.FunctionalProfile == "Admin")">Admin</option>
                    </select>
                    <p class="dmo-field__helper">Define como este título trabalha dentro dos módulos selecionados.</p>
                </div>
                <div class="dmo-field">
                    <label for="active">Estado</label>
                    <select id="active" name="active">
                        <option value="true" selected="@Model.Active">Ativo</option>
                        <option value="false" selected="@(!Model.Active)">Inativo</option>
                    </select>
                </div>
            </div>
            <div class="dmo-table-title">
                <div>
                    <h3>Módulos</h3>
                    <p class="dmo-field__helper">Estes módulos vêm do catálogo de Aplicações e serão assumidos por todos os utilizadores deste template.</p>
                </div>
            </div>
            <div class="dmo-table-wrap">
                <table class="dmo-table">
                    <thead>
                        <tr>
                            <th>Módulo</th>
                            <th>Atribuir</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.Lines.Count; i++)
                        {
                            <tr>
                                <td>
                                    @Model.Lines[i].DisplayName
                                    <input type="hidden" name="lines[@i].ModuleId" value="@Model.Lines[i].ModuleId" />
                                    <input type="hidden" name="lines[@i].DisplayName" value="@Model.Lines[i].DisplayName" />
                                </td>
                                <td><input type="checkbox" name="lines[@i].Granted" value="true" checked="@Model.Lines[i].Granted" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="dmo-modal-foot">
                <a class="dmo-button" href="/admin/templates">Cancelar</a>
                <button type="submit" class="dmo-button"><span class="dmo-button__label">Guardar</span></button>
            </div>
        </form>
    </div>
</div>
